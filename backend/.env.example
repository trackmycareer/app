# Required
DATABASE_URL=postgres://trackmy:localdev@localhost:5432/trackmy_career?sslmode=disable
JWT_SECRET=generate-a-strong-random-secret-here

# Server
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Admin seed (optional — creates an admin user on first boot if set)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Encryption key for MFA secrets. Base64-encoded 32-byte AES-256-GCM key.
# MFA is disabled in development if this is blank (and the server refuses to
# start in production). Generate one with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=

# Encryption key for private compensation history. Separate from the MFA key.
# Base64-encoded 32-byte AES-256-GCM key. Compensation is disabled in
# development if this is blank (and the server refuses to start in production).
# Generate one with: openssl rand -base64 32
COMPENSATION_ENCRYPTION_KEY=

# OAuth (optional — leave blank to disable a provider)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8080

# S3 object storage (Garage)
S3_ENDPOINT=localhost:3900
S3_ACCESS_KEY_ID=trackmy-dev-key
S3_SECRET_ACCESS_KEY=trackmy-dev-secret
S3_BUCKET=avatars
S3_USE_SSL=false
S3_PUBLIC_URL=http://localhost:3900
S3_REGION=garage

# Polar supporter integration (optional — leave blank to disable)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID_ONE_TIME=
POLAR_PRODUCT_ID_SUBSCRIPTION=
POLAR_SANDBOX=false
